# Browser/API port. Other devices on your LAN use http://<your-laptop-ip>:8787.
C6_PORT=8787

# Generate unique values before exposing an installation outside your LAN.
C6_SESSION_SECRET=change-me-before-sharing
C6_MASTER_KEY=change-me-before-storing-secrets
POSTGRES_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me

# Optional GitHub OAuth. The callback is <public-base-url>/auth/github/callback.
C6_GITHUB_CLIENT_ID=
C6_GITHUB_CLIENT_SECRET=
C6_PUBLIC_BASE_URL=http://localhost:8787

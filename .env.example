# Copy to .env and run `chmod 600 .env` before starting C6.

# Keep the default loopback binding until the public-exposure security gates are
# complete and an operator-controlled HTTPS route is in front of C6.
C6_BIND_ADDRESS=127.0.0.1
C6_PORT=8787
C6_PUBLIC_BASE_URL=http://127.0.0.1:8787
# Explicit preview opt-in. Leave false unless authenticated read-only Git is
# required and the deployment limitations in SECURITY.md are acceptable.
C6_GIT_HTTP_ENABLED=false
